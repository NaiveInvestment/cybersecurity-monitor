  "issues": {
    "auth": {
      "label": "금융 MFA, 접근 통제",
      "status": "외부접점 점검과 대체 통제",
      "examples": "라온시큐어, 아톤, 지니언스",
      "path": "금융사가 사용자 인증을 보강하면 생체인증이나 OTP, 등록된 단말만 허용하면 NAC, 관리자 접속을 재정비하면 서버 접근 통제를 발주할 수 있음.",
      "proof": "인증 수단 교체, 사용자, 단말 확대, 금융사 발주와 유료 계약",
      "source": "https://www.fsc.go.kr/no010101/88086"
    },
    "patch": {
      "label": "웹, API와 취약점 점검",
      "status": "외부접점 전수점검",
      "examples": "에스에스알, 싸이버원, 모니터랩",
      "path": "노출 시스템을 찾고 결함을 고치는 진단과 패치, 공개 웹, API 앞단에서 위험한 요청을 걸러내는 WAF는 구매 항목이 다름. 코드 수정과 설정 보완만으로 처리하는 경우도 있음.",
      "proof": "유료 취약점 점검, 웹, API 보호 장비 또는 구독 신규 도입",
      "source": "https://www.fsc.go.kr/no010101/88086"
    },
    "detect": {
      "label": "AI 위협 탐지, 관제",
      "status": "금융권 공동 관제 고도화 추진",
      "examples": "안랩, 지니언스, 이글루, 싸이버원",
      "path": "안랩, 지니언스 EDR은 단말 행동을 조사하고, 이글루 SIEM은 여러 곳의 보안 로그를 모아 분석함. 싸이버원은 관제 운영, 샌즈랩, 에스투더블유는 위협 정보를 제공함.",
      "proof": "유료 EDR 단말 수 확대, SIEM 구축, 관제 계약 또는 구독",
      "source": "https://www.fsc.go.kr/no010101/88086"
    },
    "saas": {
      "label": "금융 망분리 완화, SaaS",
      "status": "조건부 테스트, 확대 방안 추진",
      "examples": "한싹, 휴네시온, 소프트캠프, 지니언스",
      "path": "중요한 망을 남기고 승인된 파일, 로그만 밖으로 보내는 구조는 한싹, 휴네시온의 별도 망연계 발주로 이어질 수 있음. 문서 반출은 소프트캠프, 파수AI, 접속 검증은 지니언스 등 적용 구간에 따라 갈림. 허용 SaaS 직접 연결과 기존 통제도 가능한 구조.",
      "proof": "2027년 1분기 대체 보안 방안, 분리망 유지 범위, 전송 통제 규격과 실제 납품",
      "source": "https://www.fsc.go.kr/no010101/88086",
      "source2": "https://better.fsc.go.kr/fsc_new/replyCase/OpinionDetail.do?actCd=R&muGpNo=88&muNo=117&opinionIdx=2314&stNo=11"
    },
    "n2sf": {
      "label": "공공 N2SF 전환",
      "status": "6개 컨소시엄 도입 지원 진행",
      "examples": "휴네시온, 한싹",
      "path": "공공 업무를 기밀, 민감, 공개로 나누고 허용된 연계를 통제. 보호 등급이 다른 망의 자료 전송이 필요하면 망연계, CDS가 발주 후보. 휴네시온은 한국부동산원 도입 지원 과제 참여를 공시함.",
      "proof": "실증 후 본사업 예산, 기관별 장비 규격, 공급사와 납품 범위",
      "source": "https://www.kisa.or.kr/402/form?postSeq=2600",
      "source2": "https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260814003283"
    },
    "resilience": {
      "label": "정보유출 예방, 사고 대응",
      "status": "금융사 내부통제 보완",
      "examples": "파수AI, 케이사인, 지란지교시큐리티",
      "path": "파일 권한, 암호화, DB 암호화, 외부 메일 발신 통제는 유출 예방에 쓰임. 독립 백업, 재해 복구와 포렌식은 별도 구매 항목.",
      "proof": "암호화, 문서보안 제품 채택, 민감 시스템 적용 범위와 사고 대응 용역 계약",
      "source": "https://www.fsc.go.kr/no010101/88086"
    }
